from __future__ import annotations

import math
import time
from typing import Any

import torch
from torch.nn.utils import clip_grad_norm_
from tqdm.auto import tqdm

from speech_mtl.common.training.losses import (
    compute_multitask_loss,
)
from speech_mtl.common.training.phases import PhaseController

from .metrics import EpochMetricAccumulator


def _move_batch(
    batch: dict[str, Any],
    device: torch.device,
    *,
    non_blocking: bool,
) -> dict[str, Any]:
    moved = dict(batch)

    for key in (
        "features",
        "relative_lengths",
        "valid_mask",
        "lid",
        "dialect",
        "gender",
    ):
        moved[key] = batch[key].to(
            device=device,
            non_blocking=non_blocking,
        )

    return moved


def train_epoch_with_metrics(
    *,
    model,
    dataloader,
    optimizer,
    scheduler,
    amp_controller,
    device: torch.device,
    epoch: int,
    training_state,
    gradient_accumulation_steps: int,
    maximum_gradient_norm: float,
    progress_writer,
    progress_interval_batches: int,
    show_progress_bar: bool = True,
) -> dict[str, Any]:
    total_batches = len(dataloader)

    if total_batches <= 0:
        raise ValueError("Training dataloader is empty")

    model.train()
    phase = PhaseController().apply(model, epoch)

    training_state.epoch = epoch
    training_state.batch_in_epoch = 0
    training_state.phase_name = phase.name

    optimizer.zero_grad(set_to_none=True)

    accumulator = EpochMetricAccumulator()
    examples = 0
    total_loss_sum = 0.0
    raw_loss_sums = {
        "language": 0.0,
        "dialect": 0.0,
        "gender": 0.0,
    }
    optimizer_steps = 0
    gradient_norm_sum = 0.0
    gradient_norm_count = 0
    real_frames = 0
    padded_frames = 0
    started = time.monotonic()

    iterator = tqdm(
        dataloader,
        total=total_batches,
        desc=f"epoch {epoch:02d} {phase.name}",
        dynamic_ncols=True,
        disable=not show_progress_bar,
        leave=True,
    )

    for batch_index, raw_batch in enumerate(iterator, start=1):
        batch = _move_batch(
            raw_batch,
            device,
            non_blocking=True,
        )
        batch_size = int(batch["features"].shape[0])

        group_start = (
            ((batch_index - 1) // gradient_accumulation_steps)
            * gradient_accumulation_steps
        )
        group_size = min(
            gradient_accumulation_steps,
            total_batches - group_start,
        )

        with amp_controller.autocast():
            output = model(
                features=batch["features"],
                relative_lengths=batch["relative_lengths"],
                oracle_languages=batch["language"],
                valid_mask=batch["valid_mask"],
            )
            loss_output = compute_multitask_loss(
                model=model,
                output=output,
                language_targets=batch["lid"],
                dialect_targets=batch["dialect"],
                gender_targets=batch["gender"],
            )
            backward_loss = loss_output.total / group_size

        amp_controller.backward(backward_loss)

        is_optimizer_step = (
            batch_index % gradient_accumulation_steps == 0
            or batch_index == total_batches
        )

        if is_optimizer_step:
            amp_controller.unscale_(optimizer)

            gradient_norm = clip_grad_norm_(
                model.parameters(),
                max_norm=maximum_gradient_norm,
                error_if_nonfinite=True,
            )
            gradient_norm_value = float(
                gradient_norm.detach().cpu().item()
                if isinstance(gradient_norm, torch.Tensor)
                else gradient_norm
            )

            if not math.isfinite(gradient_norm_value):
                raise FloatingPointError(
                    "Non-finite gradient norm"
                )

            amp_controller.step(optimizer)
            amp_controller.update()
            optimizer.zero_grad(set_to_none=True)
            scheduler.step()

            optimizer_steps += 1
            training_state.optimizer_step += 1
            gradient_norm_sum += gradient_norm_value
            gradient_norm_count += 1

        accumulator.update(output=output, batch=batch)

        loss_value = float(
            loss_output.total.detach().cpu().item()
        )

        if not math.isfinite(loss_value):
            raise FloatingPointError(
                "Non-finite multitask training loss"
            )

        total_loss_sum += loss_value * batch_size

        for task, task_loss in loss_output.raw_losses.items():
            raw_loss_sums[task] += (
                float(task_loss.detach().cpu().item())
                * batch_size
            )

        examples += batch_size
        real_frames += int(raw_batch["real_frames"])
        padded_frames += int(raw_batch["padded_frames"])

        training_state.batch_in_epoch = batch_index
        training_state.global_batch += 1

        running_loss = total_loss_sum / examples
        learning_rates = scheduler.current_learning_rates()

        iterator.set_postfix(
            loss=f"{running_loss:.4f}",
            lr=f"{learning_rates['tasks']:.2e}",
            opt_step=training_state.optimizer_step,
        )

        if (
            batch_index % progress_interval_batches == 0
            or batch_index == total_batches
        ):
            progress_writer.write(
                {
                    "status": "TRAINING",
                    "epoch": epoch,
                    "phase": phase.name,
                    "batch": batch_index,
                    "batches": total_batches,
                    "examples_seen_in_epoch": examples,
                    "global_batch": training_state.global_batch,
                    "optimizer_step": (
                        training_state.optimizer_step
                    ),
                    "mean_total_loss": running_loss,
                    "learning_rates": learning_rates,
                    "elapsed_seconds": (
                        time.monotonic() - started
                    ),
                }
            )

    summary, _ = accumulator.finalize()
    elapsed = time.monotonic() - started
    learning_rates = scheduler.current_learning_rates()

    return {
        "epoch": epoch,
        "phase": phase.name,
        "examples": examples,
        "batches": total_batches,
        "optimizer_steps": optimizer_steps,
        "mean_total_loss": total_loss_sum / examples,
        "mean_language_loss": (
            raw_loss_sums["language"] / examples
        ),
        "mean_dialect_loss": (
            raw_loss_sums["dialect"] / examples
        ),
        "mean_gender_loss": (
            raw_loss_sums["gender"] / examples
        ),
        "summary": summary,
        "encoder_learning_rate": learning_rates["encoder"],
        "task_learning_rate": learning_rates["tasks"],
        "mean_gradient_norm": (
            gradient_norm_sum / gradient_norm_count
        ),
        "real_frames": real_frames,
        "padded_frames": padded_frames,
        "padding_ratio": (
            1.0 - real_frames / padded_frames
            if padded_frames
            else 0.0
        ),
        "elapsed_seconds": elapsed,
        "examples_per_second": examples / elapsed,
    }
